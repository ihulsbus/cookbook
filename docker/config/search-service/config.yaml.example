global:
  logLevel: INFO
  listenPort: 8080

cors:
  allowCredentials: false
  allowedOrigins:
  - http://localhost:4200
  allowedHeaders:
  - Authorization
  - Content-Type
  allowedMethods:
  - GET
  - POST
  - PUT
  - DELETE
  - HEAD

# Authentik (see cookbook/authentik/README.md) runs separately - it's not
# part of this compose file. issuer validates inbound tokens; clientid/
# clientsecret are this service's own confidential-client credentials for
# outbound service-to-service calls (see
# cookbook/authentik/blueprints/cookbook-service.yaml).
#
# Copy this file to config.yaml (gitignored, see docker-compose.yml's
# volumes for this service) and fill in clientsecret from your own
# instance - never commit a real value here.
oauth:
  issuer: https://auth.gourmedy.com/application/o/cookbook-web/
  audience: cookbook-web
  clientid: cookbook-web
  clientsecret: ""

# Downstream services this one fans a search out to (KIT-30) - forwards
# the caller's own token, doesn't call these at startup.
ingredientService:
  baseURL: http://ingredient-service:8080/api/v2

recipeService:
  baseURL: http://recipe-service:8080/api/v2

metadataService:
  baseURL: http://metadata-service:8080/api/v2
